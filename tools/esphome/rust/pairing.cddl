; Private NVS custody record. Never transmit this blob to the host or logs.
; The final digest detects accidental corruption; it does not resist physical rollback.
device-pairing-custody = [
  version: 1, kid: 0..255, private_scalar: bstr .size 32,
  public_pairing: bstr .size (1..251), endpoint: (bstr .size 6 / null), integrity: bstr .size 32
]
; public_pairing is the library pairing-record CBOR.
; endpoint is IPv4(4) || port-big-endian(2), or null before first pairing.
; integrity=BLAKE3 derive-key("coaptic device custody integrity v1", preceding bytes).
; The endpoint with the lexicographically greater pinned principal initiates EDHOC.

; Protected sample. Sent only after enrolled EDHOC/current-policy authorization.
paired-sample = [version: 1, device: bstr .size 32, at-ms: uint]
; Existing echo-only grants retain their exact echo behavior.
paired-sample-receipt = paired-sample
; Newly approved telemetry grants use the shared application operation envelope:
; 16-byte operation ID followed by paired-sample CBOR. The 56-byte durable receipt
; encodes ID(16), complete content digest(32), committed sequence big-endian(8).
; Its principal, service and grant come from the authenticated managed session.
