+#[cfg(test)]
+mod inbox_collection_tests {
+    use super::*;
+
+    fn reply(port: u16) -> (Call, ReplyMeta) {
+        let peer = Endpoint::v4([192, 0, 2, 1], port);
+        let mut wire = [0; 64];
+        let len = crate::message::encode(
+            &Message::new(Type::Acknowledgement, Code::CONTENT, MessageId::new(port))
+                .with_payload(b"retained reply"),
+            &mut wire,
+        )
+        .unwrap();
+        let parsed = crate::message::decode(&wire[..len]).unwrap();
+        (
+            Call::new(parsed.token(), peer),
+            ReplyMeta::from_parsed(&parsed, peer, 7).unwrap(),
+        )
+    }
+
+    #[test]
+    fn collected_reply_releases_credit_and_row_without_evicting_untaken_reply() {
+        let mut inbox = ClientInbox::<2>::new();
+        let lives = ClientLives::<2>::new();
+        let (first, first_meta) = reply(5683);
+        let (second, second_meta) = reply(5684);
+        let (third, third_meta) = reply(5685);
+        let body = SlotId::from_index(1);
+        inbox.insert(first, Ok(first_meta), Some(body)).unwrap();
+        inbox.insert(second, Ok(second_meta), None).unwrap();
+        assert!(inbox.insert(third, Ok(third_meta), None).is_err());
+        assert_eq!(lives.response_credits(&inbox), 2);
+        {
+            let (response, returned_body) = inbox.take(first).unwrap();
+            assert_eq!(response.unwrap().payload(), b"retained reply");
+            assert_eq!(returned_body, Some(body));
+        }
+        assert_eq!(inbox.usage(), (1, 1));
+        assert_eq!(lives.response_credits(&inbox), 1);
+        assert!(inbox.take(first).is_none());
+        assert!(inbox.partial_meta(first, body).is_none());
+        assert_eq!(inbox.insert(third, Ok(third_meta), None), Ok(None));
+        assert_eq!(
+            inbox.take(second).unwrap().0.unwrap().message_id(),
+            Some(MessageId::new(5684))
+        );
+        assert_eq!(
+            inbox.take(third).unwrap().0.unwrap().payload(),
+            b"retained reply"
+        );
+        assert!(!inbox.has_protocol_state());
+        assert_eq!(inbox.usage(), (0, 0));
+        assert_eq!(lives.response_credits(&inbox), 0);
+    }
+
+    #[test]
+    fn collected_failure_can_be_reused_for_partial_and_completed_same_call() {
+        let mut inbox = ClientInbox::<1>::new();
+        let (call, meta) = reply(5683);
+        inbox
+            .insert(call, Err(CallFailure::TimedOut), None)
+            .unwrap();
+        assert_eq!(
+            inbox.take(call).unwrap().0.unwrap_err(),
+            CallFailure::TimedOut
+        );
+        assert!(!inbox.contains(call));
+        assert!(!inbox.has_protocol_state());
+        let body = SlotId::from_index(0);
+        assert_eq!(inbox.retain_partial(call, meta, body), Ok(None));
+        assert_eq!(inbox.usage(), (1, 0));
+        assert!(inbox.take(call).is_none());
+        assert!(inbox.partial_meta(call, body).is_some());
+        assert_eq!(inbox.insert(call, Ok(meta), Some(body)), Ok(Some(body)));
+        let (response, returned_body) = inbox.take(call).unwrap();
+        assert_eq!(response.unwrap().payload(), b"retained reply");
+        assert_eq!(returned_body, Some(body));
+        assert!(!inbox.has_protocol_state());
     }
 }
 
