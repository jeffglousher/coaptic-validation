+// Successful packets use the final output tail as the AEAD buffer. The old
+// staging path remains cold so capacity/error precedence stays unchanged when
+// the final output cannot hold the message or either option domain is invalid.
+#[allow(clippy::too_many_arguments)]
+fn seal_message<T: OwnedToken>(
+    plain: &Message<'_, T>,
+    key: &[u8; super::KEY_LEN],
+    nonce: &[u8; super::NONCE_LEN],
+    aad: &[u8],
+    piv: Option<PartialIv>,
+    kid_context: Option<&[u8]>,
+    kid: Option<&[u8]>,
+    out: &mut [u8],
+) -> Result<usize, Error> {
+    let direct: Result<usize, Error> = (|| {
+        let prefix = encode_outer(
+            plain.ty(),
+            outer_code(plain.code(), plain.options()),
+            plain.message_id(),
+            plain.token(),
+            plain.options(),
+            piv,
+            kid_context,
+            kid,
+            &[],
+            out,
+        )?;
+        let tail = out.get_mut(prefix..).ok_or(Error::BufferTooSmall)?;
+        let (marker, ciphertext) = tail.split_first_mut().ok_or(Error::BufferTooSmall)?;
+        *marker = 0xff;
+        // INNER includes the authentication tag, exactly as in the staging path.
+        let capacity = ciphertext.len().min(INNER);
+        let ciphertext = &mut ciphertext[..capacity];
+        let pt_len = encode_plaintext(plain, ciphertext)?;
+        let ct_len = aead::seal_in_place(key, nonce, aad, pt_len, ciphertext)?;
+        Ok(prefix + 1 + ct_len)
+    })();
+    match direct {
+        Ok(n) => Ok(n),
+        Err(_) => seal_message_staged(plain, key, nonce, aad, piv, kid_context, kid, out),
+    }
+}
+
+#[cold]
+#[inline(never)]
+#[allow(clippy::too_many_arguments)]
+fn seal_message_staged<T: OwnedToken>(
+    plain: &Message<'_, T>,
+    key: &[u8; super::KEY_LEN],
+    nonce: &[u8; super::NONCE_LEN],
+    aad: &[u8],
+    piv: Option<PartialIv>,
+    kid_context: Option<&[u8]>,
+    kid: Option<&[u8]>,
+    out: &mut [u8],
+) -> Result<usize, Error> {
+    let mut ciphertext = [0u8; INNER];
+    let pt_len = encode_plaintext(plain, &mut ciphertext)?;
+    let ct_len = aead::seal_in_place(key, nonce, aad, pt_len, &mut ciphertext)?;
+    encode_outer(
+        plain.ty(),
+        outer_code(plain.code(), plain.options()),
+        plain.message_id(),
+        plain.token(),
+        plain.options(),
+        piv,
+        kid_context,
+        kid,
+        &ciphertext[..ct_len],
+        out,
+    )
+}
