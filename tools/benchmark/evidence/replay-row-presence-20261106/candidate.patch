 //! for that id. Rotate does not evict, so it does not consult the pin bit.
 
 use super::slot::{SlotError, SlotId};
+use crate::message::MessageId;
+
+/// Replay-table occupancy and a message-ID rejection filter share one owner.
+/// Zero is free, one is acquired without a payload, and `mid + 2` is occupied
+/// with a payload. All 16-bit IDs remain representable; a filter match still
+/// requires comparing the complete endpoint/key in the table.
+pub(crate) struct DedupIndex<S> {
+    slots: S,
+    cursor: usize,
+    count: usize,
+}
+
+impl<S> DedupIndex<S> {
+    /// The caller supplies zeroed, bounded storage, allocated only at startup.
+    pub(crate) const fn new(slots: S) -> Self {
+        Self {
+            slots,
+            cursor: 0,
+            count: 0,
+        }
+    }
+}
+
+impl<S: AsRef<[u32]> + AsMut<[u32]>> DedupIndex<S> {
+    pub(crate) fn acquire(&mut self) -> Option<SlotId> {
+        let slots = self.slots.as_mut();
+        let n = slots.len();
+        if self.count == n {
+            return None;
+        }
+        let start = self.cursor;
+        let index = if slots[start] == 0 {
+            start
+        } else {
+            slots[start..]
+                .iter()
+                .position(|&v| v == 0)
+                .map(|i| start + i)
+                .or_else(|| slots[..start].iter().position(|&v| v == 0))?
+        };
+        slots[index] = 1;
+        self.count += 1;
+        self.cursor = if index + 1 == n { 0 } else { index + 1 };
+        Some(SlotId::from_index(index))
+    }
+
+    pub(crate) fn release(&mut self, id: SlotId) -> Result<(), SlotError> {
+        let slot = self
+            .slots
+            .as_mut()
+            .get_mut(id.index())
+            .ok_or(SlotError::InvalidSlot)?;
+        if *slot == 0 {
+            return Err(SlotError::NotOccupied);
+        }
+        *slot = 0;
+        self.count -= 1;
+        Ok(())
+    }
+
+    pub(crate) fn set_mid(&mut self, id: SlotId, mid: MessageId) {
+        debug_assert!(self.is_occupied(id));
+        self.slots.as_mut()[id.index()] = u32::from(mid.get()) + 2;
+    }
+
+    pub(crate) fn matches(&self, id: SlotId, mid: MessageId) -> bool {
+        self.slots.as_ref().get(id.index()).copied() == Some(u32::from(mid.get()) + 2)
+    }
+
+    pub(crate) fn is_occupied(&self, id: SlotId) -> bool {
+        self.slots.as_ref().get(id.index()).is_some_and(|&v| v != 0)
+    }
+
+    pub(crate) fn occupied_count(&self) -> usize {
+        self.count
+    }
+    pub(crate) fn slot_count(&self) -> usize {
+        self.slots.as_ref().len()
+    }
+    pub(crate) fn cursor(&self) -> usize {
+        self.cursor
+    }
+
+    pub(crate) fn advance(&mut self, steps: usize) {
+        let n = self.slot_count();
+        if n != 0 {
+            self.cursor = (self.cursor + steps % n) % n;
+        }
+    }
+}
 
