+            pinned.write_into(&mut slot);
+            assert_eq!(slot.unwrap().tx_pin(), Some(SlotId::from_index(3)));
+            assert_eq!(slot.as_ref().unwrap().replay(), None);
+            let restored = pinned.with_replay(&bytes[..len]);
+            restored.write_into(&mut slot);
+            assert_eq!(slot.unwrap(), row);
+            assert_eq!(slot.unwrap().due_ms(), u64::MAX);
+        }
+    }
+
+    #[test]
+    fn lookup_checks_endpoint_and_tracks_overwrite_and_empty_slots() {
+        let a = Endpoint::v4([192, 0, 2, 1], 5683);
+        let b = Endpoint::v4([192, 0, 2, 2], 5683);
+        let mut table = DedupTable::<3>::new();
+        let first = DedupEntry::new(MessageId::new(7), a);
+        let second = DedupEntry::new(MessageId::new(7), b);
+        let x = table.insert(first).unwrap();
+        let y = table.insert(second).unwrap();
+        assert_eq!(table.lookup(first.key()), Some(x));
+        assert_eq!(table.lookup(second.key()), Some(y));
+        let replacement = DedupEntry::new(MessageId::new(8), b);
+        table.set_entry(x, replacement).unwrap();
+        assert_eq!(table.lookup(first.key()), None);
+        assert_eq!(table.lookup(replacement.key()), Some(x));
+        table.release(x).unwrap();
+        assert_eq!(table.lookup(replacement.key()), None);
+        let empty = table.acquire().unwrap();
+        assert_eq!(table.entry_ref(empty), None);
+        assert_eq!(table.lookup(first.key()), None);
+        assert_eq!(table.lookup(second.key()), Some(y));
+    }
+
+    #[test]
+    fn expiry_preserves_duplicate_key_removal_and_full_deadlines() {
+        let peer = Endpoint::v4([192, 0, 2, 9], 5683);
+        let mut table = DedupTable::<3>::new();
+        let first = table.acquire().unwrap();
+        let second = table.acquire().unwrap();
+        let forever = table.acquire().unwrap();
+        let row = DedupEntry::new(MessageId::new(7), peer);
+        let pin = SlotId::from_index(11);
+        table.set_entry(first, row.with_due_ms(0)).unwrap();
+        table
+            .set_entry(second, row.with_due_ms(5).with_tx_pin(pin))
+            .unwrap();
+        let last = DedupEntry::new(MessageId::new(8), peer).with_due_ms(u64::MAX);
+        table.set_entry(forever, last).unwrap();
+        let mut releases = 0;
+        assert!(table.try_expire_app(5, |id| {
+            assert_eq!(id, pin);
+            releases += 1;
+        }));
+        assert_eq!(releases, 1);
+        assert_eq!(table.entry_ref(first), None);
+        assert!(table.entry_ref(second).is_some());
+        assert_eq!(table.entry_ref(forever), Some(&last));
+        assert!(table.try_expire_app(4, |_| panic!("clock reversal must not expire")));
+        assert!(table.try_expire_app(5, |id| {
+            assert_eq!(id, pin);
+            releases += 1;
+        }));
+        assert_eq!(releases, 2);
+        assert_eq!(table.entry_ref(second), None);
+        assert!(table.try_expire_app(u64::MAX, |_| panic!("no pin")));
+        assert_eq!(table.occupied_count(), 0);
+    }
+
+    #[test]
+    fn replay_owner_transitions_preserve_active_bytes_and_refuse_oversize() {
+        let peer = Endpoint::v4([192, 0, 2, 1], 5683);
+        let pin = SlotId::from_index(3);
+        let row = DedupEntry::new(MessageId::new(7), peer)
+            .with_due_ms(9)
+            .with_replay(b"old");
+        let held = row.with_tx_pin(pin);
+        assert_eq!(held.replay(), None);
+        assert_eq!(held.with_replay(&[1; DedupEntry::REPLAY_MAX + 1]), held);
+        let replaced = held.with_replay(b"new");
+        assert_eq!(replaced.replay(), Some(&b"new"[..]));
+        assert_eq!(replaced.tx_pin(), None);
+        assert_eq!(replaced.key(), row.key());
+        assert_eq!(replaced.due_ms(), 9);
+        let empty = held.with_replay(&[]);
+        assert_eq!(empty.replay(), None);
+        assert_eq!(empty.tx_pin(), None);
+    }
