+#[cfg(test)]
+mod tests {
+    use super::ReplyPartition;
+    use crate::message::{BlockValue, MessageId, Token};
+    use crate::storage::{
+        BlockKey, BodySlots, DatagramSlots, Endpoint, Memory, PendingCons, Storage, profiles,
+    };
+
+    fn check_body_projection<S: ReplyPartition<Token = Token>>(store: &mut S) {
+        let endpoint = Endpoint::v4([192, 0, 2, 1], 5683);
+        let key = BlockKey::new(Token::new(&[1]).unwrap(), endpoint);
+        let block = BlockValue::from_size(0, false, 1024).unwrap();
+        let bytes = [0xa5; 900];
+        let incoming = store.admit_block1(key, block, &bytes, Some(900)).unwrap();
+        let transfer = store.rx_body_transfer(incoming).unwrap();
+        let pointer = store.rx_body_payload(incoming).unwrap().as_ptr();
+        let capacities = store.capacities();
+
+        let (tx, outgoing) = {
+            let (payload, mut reply) = store.partition_reply(Some(incoming));
+            let payload = payload.unwrap();
+            assert_eq!(payload.as_ptr(), pointer);
+            assert_eq!(payload, bytes);
+            assert_eq!(reply.capacities(), capacities);
+            assert!(reply.rx_body().is_none());
+            assert!(reply.rx_body_payload(incoming).is_none());
+            assert!(reply.rx_body_transfer(incoming).is_none());
+            assert!(reply.lookup_rx_body(key).is_none());
+            assert!(reply.set_rx_body_transfer(incoming, transfer).is_err());
+            assert!(reply.write_block1(incoming, block, b"replacement").is_err());
+            assert!(reply.admit_block1(key, block, b"new", None).is_err());
+
+            // Encoding and retained outgoing snapshots can use the borrowed bytes.
+            let tx = reply.tx_datagram().acquire().unwrap();
+            reply.tx_payload_mut(tx).unwrap()[..payload.len()].copy_from_slice(payload);
+            reply.set_tx_len(tx, payload.len()).unwrap();
+            let pending = reply
+                .reserve_pending_con(tx, endpoint, MessageId::new(7))
+                .unwrap();
+            assert_eq!(reply.pending_con(tx), Some(pending));
+            let outgoing = reply.start_block2(key, payload, 6).unwrap();
+            assert_eq!(reply.tx_body_payload(outgoing), Some(payload));
+            assert_eq!(payload, bytes);
+            (tx, outgoing)
+        };
+
+        assert_eq!(store.rx_body_payload(incoming), Some(bytes.as_slice()));
+        assert_eq!(store.rx_body_transfer(incoming), Some(transfer));
+        assert_eq!(store.tx_payload(tx), Some(bytes.as_slice()));
+        assert!(store.pending_con(tx).is_some());
+        assert_eq!(store.tx_body_payload(outgoing), Some(bytes.as_slice()));
+        store.rx_body().unwrap().release(incoming).unwrap();
+        assert!(store.rx_body_payload(incoming).is_none());
+        // Releasing the original body cannot invalidate the retained reply.
+        assert_eq!(store.tx_body_payload(outgoing), Some(bytes.as_slice()));
+    }
+
+    #[test]
+    fn fixed_reply_projection_keeps_capacity_and_borrows_body_in_place() {
+        check_body_projection(&mut Memory::<profiles::Constrained>::with_block_wise());
+    }
+
+    #[cfg(feature = "alloc")]
+    #[test]
+    fn allocated_reply_projection_keeps_capacity_and_borrows_body_in_place() {
+        let capacities = crate::storage::Capacities::from_profile::<profiles::Constrained>()
+            .with_block_wise::<profiles::Constrained>();
+        let mut store = crate::storage::AllocMemory::try_new(capacities, usize::MAX).unwrap();
+        check_body_projection(&mut store);
+    }
+
+    fn check_no_body_projection<S: ReplyPartition<Token = Token>>(store: &mut S) {
+        let capacities = store.capacities();
+        let tx = {
+            let (payload, mut reply) = store.partition_reply(None);
+            assert!(payload.is_none());
+            assert_eq!(reply.capacities(), capacities);
+            assert!(reply.rx_body().is_none());
+            assert!(reply.tx_body().is_none());
+            let tx = reply.tx_datagram().acquire().unwrap();
+            reply.tx_payload_mut(tx).unwrap()[..4].copy_from_slice(b"test");
+            reply.set_tx_len(tx, 4).unwrap();
+            tx
+        };
+        assert_eq!(store.tx_payload(tx), Some(b"test".as_slice()));
+    }
+
+    #[test]
+    fn fixed_reply_projection_without_bodies_keeps_datagram_access() {
+        check_no_body_projection(&mut Memory::<profiles::Constrained>::new());
+    }
+
+    #[cfg(feature = "alloc")]
+    #[test]
+    fn allocated_reply_projection_without_bodies_keeps_datagram_access() {
+        let capacities = crate::storage::Capacities::from_profile::<profiles::Constrained>();
+        let mut store = crate::storage::AllocMemory::try_new(capacities, usize::MAX).unwrap();
+        check_no_body_projection(&mut store);
+    }
+}
