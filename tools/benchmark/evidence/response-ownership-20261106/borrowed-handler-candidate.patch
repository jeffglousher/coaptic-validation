+//! Temporary response-phase access without borrowing the incoming body through Engine.
+
+use super::block::{BlockKey, BlockProgress, BlockRole, BlockTransfer, BodyOps, OutgoingBlock};
+use super::{Access, AccessMut, SlotError, SlotId, Storage};
+use crate::app::AppStorage;
+use crate::error::BlockTransferError;
+use crate::message::{BlockValue, OwnedToken};
+
+/// Split a completed incoming body from the storage needed to encode its reply.
+///
+/// The returned payload borrows only bytes; the reply view does not retain a
+/// reference to the incoming pool or its metadata. Configured capacities remain
+/// unchanged, but incoming-pool access is temporarily unavailable: `rx_body` and
+/// incoming body reads return `None`, and incoming mutations refuse. Datagram,
+/// outgoing-body and table operations remain available. After both values drop,
+/// release the completed body through the original storage.
+/// This temporary view must not run incoming transfer admission or progress.
+pub trait ReplyPartition: AppStorage {
+    /// Storage capabilities available while the incoming body is borrowed.
+    type Reply<'a>: AppStorage<Token = <Self as Storage>::Token>
+    where
+        Self: 'a;
+
+    /// Borrow `body` and the remaining storage without moving or copying its bytes.
+    fn partition_reply(&mut self, body: Option<SlotId>) -> (Option<&[u8]>, Self::Reply<'_>);
+}
+
+/// No incoming-pool access during reply encoding. A zero-sized facade avoids
+/// adding Sync requirements to custom incoming-body storage across an await.
+pub(crate) struct IncomingUnavailable<T>(core::marker::PhantomData<fn() -> T>);
+
+impl<T> IncomingUnavailable<T> {
+    pub(crate) fn new() -> Self {
+        Self(core::marker::PhantomData)
+    }
+}
+
+impl<T: OwnedToken> BodyOps<T> for IncomingUnavailable<T> {
+    fn payload(&self, _id: SlotId) -> Option<&[u8]> {
+        None
+    }
+
+    fn transfer(&self, _id: SlotId) -> Option<BlockTransfer<T>> {
+        None
+    }
+
+    fn lookup(&self, _key: BlockKey<T>) -> Option<SlotId> {
+        None
+    }
+
+    fn set_transfer(&mut self, _id: SlotId, _transfer: BlockTransfer<T>) -> Result<(), SlotError> {
+        Err(SlotError::Pinned)
+    }
+
+    fn admit_incoming(
+        &mut self,
+        _key: BlockKey<T>,
+        _role: BlockRole,
+        _block: BlockValue,
+        _payload: &[u8],
+        _expected_len: Option<u32>,
+    ) -> Result<SlotId, BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn write_incoming(
+        &mut self,
+        _id: SlotId,
+        _role: BlockRole,
+        _block: BlockValue,
+        _payload: &[u8],
+    ) -> Result<BlockProgress, BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn apply_incoming(
+        &mut self,
+        _key: BlockKey<T>,
+        _role: BlockRole,
+        _block: BlockValue,
+        _payload: &[u8],
+        _expected_len: Option<u32>,
+    ) -> Result<BlockProgress, BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn start_outgoing(
+        &mut self,
+        _key: BlockKey<T>,
+        _role: BlockRole,
+        _body: &[u8],
+        _szx: u8,
+    ) -> Result<SlotId, BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn next_outgoing(
+        &mut self,
+        _id: SlotId,
+        _role: BlockRole,
+    ) -> Result<OutgoingBlock, BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn adopt_smaller_outgoing_szx(
+        &mut self,
+        _id: SlotId,
+        _role: BlockRole,
+        _szx: u8,
+    ) -> Result<(), BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn next_bert_outgoing(
+        &mut self,
+        _id: SlotId,
+        _role: BlockRole,
+        _max_payload: usize,
+    ) -> Result<OutgoingBlock, BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn ack_outgoing(
+        &mut self,
+        _id: SlotId,
+        _role: BlockRole,
+        _num: u32,
+    ) -> Result<BlockProgress, BlockTransferError> {
+        Err(SlotError::Pinned.into())
+    }
+
+    fn access(&mut self, _id: SlotId) -> Result<Access<'_>, SlotError> {
+        Err(SlotError::Pinned)
+    }
+
+    fn access_mut(&mut self, _id: SlotId) -> Result<AccessMut<'_>, SlotError> {
+        Err(SlotError::Pinned)
+    }
+}
