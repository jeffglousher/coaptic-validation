+
+#[test]
+fn borrowed_upload_reply_keeps_body_across_pending_send_and_releases_on_cancel() {
+    fn echo(request: Request<'_>) -> Response<'_> {
+        let body = request.body().expect("completed upload");
+        assert_eq!(body, &[0x5a; 160]);
+        Response::changed().payload_borrowed(body)
+    }
+    for cancel in [false, true] {
+        let ready = Cell::new(true);
+        let accepted = Cell::new(0);
+        let mut app = App::with_resources(
+            Resources::<profiles::Constrained>::new()
+                .routes::<1>()
+                .block_wise::<true>(),
+        )
+        .allow_unprotected()
+        .deterministic_for_tests()
+        .route("echo", crate::app::put(echo))
+        .bind(Io {
+            ready: &ready,
+            accepted: &accepted,
+        })
+        .unwrap();
+        let mut clock = || Ok::<_, ()>(10);
+        let mut timer = Timer;
+        for num in 0..2 {
+            let block = BlockValue::from_size(num, num == 0, 128).unwrap().encode();
+            let options = [Opt::uri_path("echo"), Opt::block1(&block)];
+            let bytes = [0x5a; 128];
+            let message = Message::new(
+                Type::Confirmable,
+                Code::PUT,
+                MessageId::new(80 + num as u16),
+            )
+            .with_options(&options)
+            .with_payload(&bytes[..if num == 0 { 128 } else { 32 }]);
+            let mut wire = [0; 256];
+            let len = encode(&message, &mut wire).unwrap();
+            let rx = app.engine.acquire_rx().unwrap();
+            app.engine.write_rx(rx, &wire[..len], PEER).unwrap();
+            ready.set(num == 0);
+            {
+                let mut progress = pin!(app.progress_async(10, &mut clock, &mut timer, 100));
+                let outcome = progress
+                    .as_mut()
+                    .poll(&mut Context::from_waker(Waker::noop()));
+                if num == 0 {
+                    assert!(matches!(outcome, Poll::Ready(Ok(()))));
+                } else {
+                    assert!(outcome.is_pending());
+                    if !cancel {
+                        ready.set(true);
+                        assert!(matches!(
+                            progress
+                                .as_mut()
+                                .poll(&mut Context::from_waker(Waker::noop())),
+                            Poll::Ready(Ok(()))
+                        ));
+                    }
+                }
+            }
+        }
+        assert_eq!(accepted.get(), if cancel { 1 } else { 2 });
+        let usage = app.engine.storage_usage();
+        assert_eq!(usage.rx_body.unwrap().occupied, 0);
+        assert_eq!(usage.rx_datagram.occupied, 0);
+        assert_eq!(usage.tx_datagram.occupied, 0);
+    }
+}
