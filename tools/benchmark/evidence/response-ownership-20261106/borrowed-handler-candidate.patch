+        Capacities::from_profile::<P>().with_block_wise::<P>()
+    }
+    impl_common_storage!([*]);
+    fn rx_body(&mut self) -> Option<&mut dyn SlotPool> {
+        None
+    }
+    fn tx_body(&mut self) -> Option<&mut dyn SlotPool> {
+        Some(self.bodies.tx)
+    }
+}
+
+impl<P: MemoryProfile> ReplyPartition for Memory<P>
+where
+    P::RxDatagram: DatagramBytes,
+    P::TxDatagram: DatagramBytes,
+    P::Dedup: DedupStore,
+    P::Observe: ObserveStore<P::Token>,
+    P::Exchange: ExchangeStore<P::Token>,
+{
+    type Reply<'a>
+        = MemoryReply<'a, P>
+    where
+        Self: 'a;
+    fn partition_reply(&mut self, _body: Option<SlotId>) -> (Option<&[u8]>, Self::Reply<'_>) {
+        (
+            None,
+            MemoryReply {
+                retransmit_cursor: &mut self.retransmit_cursor,
+                rx: &mut self.rx,
+                tx: &mut self.tx,
+                dedup: &mut self.dedup,
+                observe: &mut self.observe,
+                exchange: &mut self.exchange,
+                bodies: NoBodies,
+            },
+        )
+    }
+}
+
+impl<P: MemoryProfile> ReplyPartition for Memory<P, WithBodies<P>>
+where
+    P::RxDatagram: DatagramBytes,
+    P::TxDatagram: DatagramBytes,
+    P::Dedup: DedupStore,
+    P::Observe: ObserveStore<P::Token>,
+    P::Exchange: ExchangeStore<P::Token>,
+    P::RxBody: BodyOps<P::Token>,
+    P::TxBody: BodyOps<P::Token>,
+{
+    type Reply<'a>
+        = MemoryReply<'a, P, ReplyBodies<'a, P>>
+    where
+        Self: 'a;
+    fn partition_reply(&mut self, body: Option<SlotId>) -> (Option<&[u8]>, Self::Reply<'_>) {
+        let payload = body.and_then(|id| self.bodies.rx.payload(id));
+        (
+            payload,
+            MemoryReply {
+                retransmit_cursor: &mut self.retransmit_cursor,
+                rx: &mut self.rx,
+                tx: &mut self.tx,
+                dedup: &mut self.dedup,
+                observe: &mut self.observe,
+                exchange: &mut self.exchange,
+                bodies: ReplyBodies {
+                    rx: IncomingUnavailable::new(),
+                    tx: &mut self.bodies.tx,
+                },
+            },
+        )
+    }
+}
 
