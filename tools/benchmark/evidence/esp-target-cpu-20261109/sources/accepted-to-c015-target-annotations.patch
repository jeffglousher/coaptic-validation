diff --git a/crates/coaptic-io/tests/conditional_outline.rs b/crates/coaptic-io/tests/conditional_outline.rs
new file mode 100644
index 0000000..675c9b4
--- /dev/null
+++ b/crates/coaptic-io/tests/conditional_outline.rs
@@ -0,0 +1,191 @@
+use core::cell::Cell;
+use core::future::{Future, poll_fn};
+use core::pin::pin;
+use core::task::{Context, Poll, Waker};
+
+struct Owner<'a>(&'a Cell<usize>);
+
+impl Drop for Owner<'_> {
+    fn drop(&mut self) {
+        self.0.set(self.0.get() + 1);
+    }
+}
+
+fn wait(polls: &Cell<usize>) -> usize {
+    polls.set(polls.get() + 1);
+    42
+}
+
+async fn wait_async(polls: &Cell<usize>) -> usize {
+    poll_fn(|context| {
+        polls.set(polls.get() + 1);
+        if polls.get() == 1 {
+            context.waker().wake_by_ref();
+            Poll::Pending
+        } else {
+            Poll::Ready(42)
+        }
+    })
+    .await
+}
+
+#[coaptic_io::dual_io(outlined_async, outline_if(all()), calls(wait => wait_async))]
+fn outlined(polls: &Cell<usize>, drops: &Cell<usize>) -> usize {
+    let _owner = Owner(drops);
+    wait(polls)
+}
+
+#[coaptic_io::dual_io(ordinary_async, outline_if(any()), calls(wait => wait_async))]
+fn ordinary(polls: &Cell<usize>, drops: &Cell<usize>) -> usize {
+    let _owner = Owner(drops);
+    wait(polls)
+}
+
+#[coaptic_io::dual_io(original_async, calls(wait => wait_async))]
+fn original(polls: &Cell<usize>, drops: &Cell<usize>) -> usize {
+    let _owner = Owner(drops);
+    wait(polls)
+}
+
+#[coaptic_io::dual_io(sync_only_async, sync_outline_if(all()), calls(wait => wait_async))]
+fn sync_only(polls: &Cell<usize>, drops: &Cell<usize>) -> usize {
+    let _owner = Owner(drops);
+    wait(polls)
+}
+
+async fn selected(outline: bool, polls: &Cell<usize>, drops: &Cell<usize>) -> usize {
+    if outline {
+        outlined_async(polls, drops).await
+    } else {
+        ordinary_async(polls, drops).await
+    }
+}
+
+#[test]
+fn preserves_synchronous_owners_with_either_condition() {
+    for run in [outlined, ordinary, original, sync_only] {
+        let polls = Cell::new(0);
+        let drops = Cell::new(0);
+        assert_eq!(run(&polls, &drops), 42);
+        assert_eq!((polls.get(), drops.get()), (1, 1));
+    }
+}
+
+#[test]
+fn unpolled_bodies_do_not_start() {
+    let polls = Cell::new(0);
+    let drops = Cell::new(0);
+    drop(outlined_async(&polls, &drops));
+    drop(ordinary_async(&polls, &drops));
+    assert_eq!((polls.get(), drops.get()), (0, 0));
+}
+
+#[test]
+fn either_condition_releases_live_owner_on_pending_cancellation() {
+    for outline in [false, true] {
+        let polls = Cell::new(0);
+        let drops = Cell::new(0);
+        {
+            let mut operation = pin!(selected(outline, &polls, &drops));
+            assert!(
+                operation
+                    .as_mut()
+                    .poll(&mut Context::from_waker(Waker::noop()))
+                    .is_pending()
+            );
+            assert_eq!((polls.get(), drops.get()), (1, 0));
+        }
+        assert_eq!((polls.get(), drops.get()), (1, 1));
+    }
+}
+
+#[test]
+fn either_condition_resumes_and_releases_owner_before_ready() {
+    for outline in [false, true] {
+        let polls = Cell::new(0);
+        let drops = Cell::new(0);
+        let mut operation = pin!(selected(outline, &polls, &drops));
+        let mut context = Context::from_waker(Waker::noop());
+        assert!(operation.as_mut().poll(&mut context).is_pending());
+        assert_eq!(operation.as_mut().poll(&mut context), Poll::Ready(42));
+        assert_eq!((polls.get(), drops.get()), (2, 1));
+    }
+}
+
+#[test]
+fn disabled_boundary_keeps_original_future_layout() {
+    let polls = Cell::new(0);
+    let drops = Cell::new(0);
+    let ordinary = ordinary_async(&polls, &drops);
+    let original = original_async(&polls, &drops);
+    assert_eq!(
+        core::mem::size_of_val(&ordinary),
+        core::mem::size_of_val(&original)
+    );
+    assert_eq!(
+        core::mem::align_of_val(&ordinary),
+        core::mem::align_of_val(&original)
+    );
+}
+
+#[test]
+fn synchronous_hint_does_not_wrap_the_async_future() {
+    let polls = Cell::new(0);
+    let drops = Cell::new(0);
+    let sync_only = sync_only_async(&polls, &drops);
+    let original = original_async(&polls, &drops);
+    assert_eq!(
+        core::mem::size_of_val(&sync_only),
+        core::mem::size_of_val(&original)
+    );
+    assert_eq!(
+        core::mem::align_of_val(&sync_only),
+        core::mem::align_of_val(&original)
+    );
+    drop(sync_only);
+    assert_eq!((polls.get(), drops.get()), (0, 0));
+}
+
+#[test]
+fn synchronous_hint_preserves_async_cancellation_and_completion() {
+    for complete in [false, true] {
+        let polls = Cell::new(0);
+        let drops = Cell::new(0);
+        {
+            let mut operation = pin!(sync_only_async(&polls, &drops));
+            let mut context = Context::from_waker(Waker::noop());
+            assert!(operation.as_mut().poll(&mut context).is_pending());
+            assert_eq!((polls.get(), drops.get()), (1, 0));
+            if complete {
+                assert_eq!(operation.as_mut().poll(&mut context), Poll::Ready(42));
+                assert_eq!((polls.get(), drops.get()), (2, 1));
+            }
+        }
+        assert_eq!(drops.get(), 1);
+    }
+}
+
+#[coaptic_io::dual_io(owned_outlined_async, outline_if(all()), calls(wait => wait_async))]
+fn owned_outlined(owner: Owner<'_>, polls: &Cell<usize>) -> usize {
+    let _owner = owner;
+    wait(polls)
+}
+
+#[coaptic_io::dual_io(owned_ordinary_async, outline_if(any()), calls(wait => wait_async))]
+fn owned_ordinary(owner: Owner<'_>, polls: &Cell<usize>) -> usize {
+    let _owner = owner;
+    wait(polls)
+}
+
+#[test]
+fn unpolled_future_releases_owned_arguments_with_either_condition() {
+    let polls = Cell::new(0);
+    let drops = Cell::new(0);
+    drop(owned_outlined_async(Owner(&drops), &polls));
+    assert_eq!((polls.get(), drops.get()), (0, 1));
+    drop(owned_ordinary_async(Owner(&drops), &polls));
+    assert_eq!((polls.get(), drops.get()), (0, 2));
+    assert_eq!(owned_outlined(Owner(&drops), &polls), 42);
+    assert_eq!(owned_ordinary(Owner(&drops), &polls), 42);
+    assert_eq!((polls.get(), drops.get()), (2, 4));
+}
