# Preparation hashes the exact lock bytes; keep them identical on every host.
**/Cargo.lock text eol=lf

# Preserve vendored package and original RFC bytes for provenance checks.
/vendor/webrtc-dtls/** -text
/knowledge/rfcs/*.txt -text

tools/interop/libcoap/patches/*.patch text eol=lf

# Retain exact receipt bytes and diagnostic-wrapper hashes across checkouts.
tools/qualification/evidence/independent-observe/** -text whitespace=cr-at-eol
tools/qualification/evidence/bpf-ingress/*.json -text whitespace=cr-at-eol
# Existing bootstrap receipt was committed with LF; keep its index hash portable.
tools/qualification/evidence/independent-edhoc/options-ce7e817-8f88d76.json text eol=lf

# Preserve original qualification logs, JSON and embedded receipt hashes.
tools/qualification/evidence/completion-20261020/** -text whitespace=-blank-at-eol
tools/benchmark/evidence/hot-path-windows-20261021/** -text whitespace=-blank-at-eol
