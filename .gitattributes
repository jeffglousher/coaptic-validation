# Preparation hashes the exact lock bytes; keep them identical on every host.
**/Cargo.lock text eol=lf
**/Cargo.syn3.lock text eol=lf

# Preserve vendored package and original RFC bytes for provenance checks.
/vendor/webrtc-dtls/** -text
/knowledge/rfcs/*.txt -text

tools/interop/libcoap/patches/*.patch text eol=lf

# Retain exact receipt bytes and diagnostic-wrapper hashes across checkouts.
tools/qualification/evidence/independent-observe/** -text whitespace=cr-at-eol
tools/qualification/evidence/bpf-ingress/*.json -text whitespace=cr-at-eol
# Existing bootstrap receipt was committed with LF; keep its index hash portable.
tools/qualification/evidence/independent-edhoc/options-ce7e817-8f88d76.json text eol=lf

# Preserve original qualification logs, JSON and embedded receipt hashes.
tools/qualification/evidence/completion-20261020/** -text whitespace=-blank-at-eol
tools/benchmark/evidence/hot-path-windows-20261021/** -text whitespace=-blank-at-eol
tools/benchmark/evidence/cpu-cost-windows-20261022/** -text whitespace=-blank-at-eol
tools/benchmark/evidence/cpu-cost-linux-20261022/** -text whitespace=-blank-at-eol

# The live replay manifest is hashed as exact source bytes on every host.
tools/benchmark/windows_live_replay_pins.json text eol=lf

# Keep the live profiling proof and its integrity index byte-exact.
tools/benchmark/evidence/windows-live-c1-capability-20261030/** -text
tools/benchmark/evidence/admission-headroom-20261030/** -text

/tools/esphome/rust/Cargo.syn2.lock text eol=lf
tools/benchmark/evidence/dedup-classified-20261030/** -text

# Stable compile-time Stage B contract on Windows and Unix checkouts.
tools/benchmark/admission_stage_b_contract.json text eol=lf
tools/benchmark/evidence/admission-stage-b-20261030/** -text

# Source-matched CI macro lock alternatives are byte-pinned.
/Cargo.syn3.lock text eol=lf
/tools/durable-host/Cargo.syn3.lock text eol=lf
/fuzz/Cargo.syn3.lock text eol=lf

# Preserve exact common-MCU diagnostic source and numeric manifest bytes.
tools/benchmark/evidence/mcu-processing-span-20261109/** -text whitespace=cr-at-eol
# The matcher changes only its private address; retain its original terminal blank line.
tools/benchmark/evidence/mcu-processing-span-20261109/sources/mcu_processing_span_v2.py whitespace=cr-at-eol,-blank-at-eof
