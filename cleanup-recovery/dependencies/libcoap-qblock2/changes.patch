--- a/include/coap3/coap_pdu_internal.h
+++ b/include/coap3/coap_pdu_internal.h
@@ -173,6 +173,10 @@ struct coap_pdu_t {
   size_t body_total;        /**< Holds body data total size */
   coap_lg_xmit_t *lg_xmit;  /**< Holds ptr to lg_xmit if sending a set of
                                  blocks */
+#if COAP_OSCORE_SUPPORT && COAP_Q_BLOCK_SUPPORT
+  uint32_t oscore_q_block2; /**< Packed inner Q-Block2 continuation for encrypted
+                                UDP CON; zero means none. lg_xmit is weak. */
+#endif
   coap_session_t *session;  /**< Session responsible for PDU or NULL */
   coap_binary_t *data_free; /**< Data to be freed off by coap_delete_pdu() */
 };
diff --git a/src/coap_block.c b/src/coap_block.c
index 07dedd56c92b2efd39065350baad66023aa32bb3..0d5c7f7cf80b6559c9bda1f627d75f5f67d5fb51 100644
--- a/src/coap_block.c
+++ b/src/coap_block.c
@@ -2351,6 +2351,27 @@ coap_block_delete_lg_xmit(coap_session_t *session,
   if (lg_xmit == NULL)
     return;
 
+#if COAP_OSCORE_SUPPORT && COAP_Q_BLOCK_SUPPORT
+  /* Revoke every queued encrypted continuation before release callbacks/free.
+   * Clearing both fields prevents a reused allocation from acquiring an old ACK.
+   * These are the two owners of a queued UDP CON PDU. */
+  {
+    coap_queue_t *q;
+    LL_FOREACH(session->context->sendqueue, q) {
+      if (q->session == session && q->pdu &&
+          q->pdu->oscore_q_block2 && q->pdu->lg_xmit == lg_xmit) {
+        q->pdu->lg_xmit = NULL;
+        q->pdu->oscore_q_block2 = 0;
+      }
+    }
+    LL_FOREACH(session->delayqueue, q) {
+      if (q->pdu && q->pdu->oscore_q_block2 && q->pdu->lg_xmit == lg_xmit) {
+        q->pdu->lg_xmit = NULL;
+        q->pdu->oscore_q_block2 = 0;
+      }
+    }
+  }
+#endif
   if (lg_xmit->release_func) {
     coap_lock_callback(session->context, lg_xmit->release_func(session, lg_xmit->app_ptr));
   }
